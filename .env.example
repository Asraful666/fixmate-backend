# Server
PORT=5000
CLIENT_URL=http://localhost:3000
# Comma separated extra origins for production
CORS_ORIGINS=

# Database (same database as the frontend)
DB_NAME=fixmate
MONGODB_URI=

# BetterAuth base URL (must match the frontend BETTER_AUTH_URL)
BETTER_AUTH_URL=http://localhost:3000

# Stripe test mode
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Pro plan price in USD (default 19)
PRO_PLAN_PRICE=19
